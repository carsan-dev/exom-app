+    // EXOM local patch: VideoPublisher can block in eglSwapBuffers until the encoder releases an input
+    // surface buffer. execute() drains at most one encoder output per call and none when an upstream step
+    // waits, so first deliver every encoder output that is already available through the rest of the chain.
+    private fun drainBeforePublish(from: Int) {
+        val encoder = chain.getOrNull(from)?.takeIf { it is QueuedStep<*, *, *, *> } ?: return
+        var drained = 0
+        while (true) {
+            var state = executeStep(State.Ok(Unit), encoder, fresh = false) ?: break
+            for (index in from + 1 until chain.size) {
+                check(state !is State.Eos) { "Unexpected EOS while draining before publish" }
+                state = executeStep(state, chain[index], fresh = true)
+                    ?: error("Step ${chain[index].name} waited while draining before publish")
+            }
+            check(state !is State.Eos) { "Unexpected EOS while draining before publish" }
+            drained++
+        }
+        if (drained > 0) log.v("execute(): drained $drained ${encoder.name} output(s) before publishing")
+    }
